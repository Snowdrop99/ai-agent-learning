# 复制成 .env 后填你自己的 key。三个变量改成任意 OpenAI 兼容 provider 都能跑。
#
# DeepSeek : LLM_BASE_URL=https://api.deepseek.com        LLM_MODEL=deepseek-chat
# 智谱 GLM : LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4.7
# 阿里百炼 : LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
